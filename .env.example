DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
GEMINI_API_KEY=your-gemini-api-key
FINNHUB_API_KEY=your-finnhub-api-key
# Default model: gemini-2.5-flash (auto-configures Google's OpenAI-compatible endpoint)
MODEL=gemini-2.5-flash
# Optional: for OpenAI models (gpt-4o-mini, etc.) — also used for embeddings
# OPENAI_API_KEY=sk-...
# Optional: for Claude models (claude-sonnet-4-20250514, etc.)
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Gemini/OpenAI base URL
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: Vertex AI for Claude models
# GCP_PROJECT=your-project-id
# GCP_REGION=us-central1
